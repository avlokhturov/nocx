#!/bin/sh
set -eu

# Pull the issue tracker when git brings in someone else's work.
#
# The backlog lives in refs/dolt/data on the same remote as the code, but git
# does not move it: .githooks/pre-push sends ours out, and until this hook
# nothing brought anyone else's in (nocx-wj4). Three people on three machines
# meant three private views of the backlog, each as fresh as the last time
# somebody remembered to type `bd dolt pull`.
#
# Measured on git 2.55.0, this hook covers both fast-forward cases:
#   git pull                              -> post-merge
#   git pull --rebase, no local commits   -> post-merge (still a fast-forward)
# The remaining case, `git pull --rebase` with local commits to replay, runs
# post-checkout and post-rewrite instead — that one is covered by
# .githooks/post-rewrite.
#
# There is deliberately no post-checkout hook. It fires on every branch switch,
# many times a day, and a network round trip on each one is the kind of tax
# people disable hooks to escape. post-rewrite catches the rebase case without
# charging for the other ninety-nine.

. "$(dirname "$0")/beads-hook.sh"

pull_beads_state
