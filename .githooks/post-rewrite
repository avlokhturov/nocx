#!/bin/sh
set -eu

# The rebase half of the tracker pull. See .githooks/post-merge for why.
#
# `git pull --rebase` with local commits to replay never reaches post-merge, so
# without this hook the one workflow the session-close protocol actually
# prescribes (`git pull --rebase`) would be the one that never refreshed the
# backlog (nocx-wj4).
#
# git also calls post-rewrite after `git commit --amend`, where there is nothing
# to sync and the network round trip would be pure cost. $1 tells the two apart.

case "${1:-}" in
    rebase) ;;
    *) exit 0 ;;
esac

. "$(dirname "$0")/beads-hook.sh"

pull_beads_state
